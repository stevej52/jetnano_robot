<?xml version="1.0" ?>
<!--
  Copyright 2026 stevej52
  Licensed under the Apache License, Version 2.0. See LICENSE.

  A world with enough visual texture for visual odometry to work in.

  This is the part of a simulator people get wrong for this robot. The robot
  has no wheel encoders: its only odometry comes from rtabmap tracking corners
  between camera frames. A default Gazebo world is a grey plane under a grey
  sky, which has no corners anywhere, so the odometry finds nothing, tracks
  nothing, and produces no pose. The robot then looks broken when the SCENE is
  what is broken.

  We measured what a poor visual signal costs on the real hardware: a camera
  feed with a discontinuity in it drove 146 tracking losses a minute and
  pushed rgbd_odometry from 79% of a core to 95%. An untextured world is that
  failure, permanently.

  So the texture here is geometric rather than painted on: a field of small
  boxes in varied colours and heights. Geometry cannot fail to load the way a
  missing texture file can, and every box edge is a corner for the detector.

  The ramps exist to test jetnano_bringup's tilt_guard at known angles:
  12 degrees is below its 25 degree roll trigger, 30 is above it. Driving
  across them side-on is the roll case; straight up is the pitch case.
-->
<sdf version="1.9">
  <world name="testbed">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Bright and slightly angled: flat lighting washes out the corners. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.35 0.33 0.30 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Texture field. Flat tiles, 2 mm proud of the floor so they are visual
      only and the robot drives straight over them without the physics
      noticing. Their edges are what the corner detector locks onto.
    -->
    <model name="texture_field">
      <static>true</static>
      <link name="link">

        <visual name="t0">
          <pose>1.0 1.0 0.001 0 0 0.3</pose>
          <geometry><box><size>0.30 0.30 0.002</size></box></geometry>
          <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.8 0.25 0.25 1</diffuse></material>
        </visual>
        <visual name="t1">
          <pose>1.6 -0.7 0.001 0 0 1.1</pose>
          <geometry><box><size>0.25 0.40 0.002</size></box></geometry>
          <material><ambient>0.2 0.5 0.7 1</ambient><diffuse>0.25 0.6 0.8 1</diffuse></material>
        </visual>
        <visual name="t2">
          <pose>2.4 0.5 0.001 0 0 0.8</pose>
          <geometry><box><size>0.35 0.22 0.002</size></box></geometry>
          <material><ambient>0.8 0.7 0.2 1</ambient><diffuse>0.9 0.8 0.25 1</diffuse></material>
        </visual>
        <visual name="t3">
          <pose>0.6 -1.5 0.001 0 0 2.0</pose>
          <geometry><box><size>0.28 0.28 0.002</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.35 0.7 0.35 1</diffuse></material>
        </visual>
        <visual name="t4">
          <pose>3.1 -1.2 0.001 0 0 0.5</pose>
          <geometry><box><size>0.40 0.26 0.002</size></box></geometry>
          <material><ambient>0.6 0.3 0.6 1</ambient><diffuse>0.7 0.35 0.7 1</diffuse></material>
        </visual>
        <visual name="t5">
          <pose>-0.9 0.9 0.001 0 0 1.7</pose>
          <geometry><box><size>0.32 0.20 0.002</size></box></geometry>
          <material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.85 0.5 0.25 1</diffuse></material>
        </visual>
        <visual name="t6">
          <pose>-1.7 -0.4 0.001 0 0 0.9</pose>
          <geometry><box><size>0.22 0.36 0.002</size></box></geometry>
          <material><ambient>0.25 0.25 0.6 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material>
        </visual>
        <visual name="t7">
          <pose>2.0 1.8 0.001 0 0 2.4</pose>
          <geometry><box><size>0.30 0.30 0.002</size></box></geometry>
          <material><ambient>0.5 0.5 0.2 1</ambient><diffuse>0.6 0.6 0.25 1</diffuse></material>
        </visual>

      </link>
    </model>

    <!--
      Walls. Broken into panels of different colours so the lidar sees a room
      and the camera sees vertical edges to track. A single long wall of one
      colour gives the camera almost nothing.
    -->
    <model name="walls">
      <static>true</static>
      <link name="link">

        <collision name="north"><pose>0 5 0.5 0 0 0</pose>
          <geometry><box><size>12 0.1 1.0</size></box></geometry></collision>
        <visual name="north_a"><pose>-3 5 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.55 1</ambient><diffuse>0.7 0.7 0.65 1</diffuse></material></visual>
        <visual name="north_b"><pose>3 5 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.45 0.5 0.55 1</ambient><diffuse>0.5 0.6 0.65 1</diffuse></material></visual>

        <collision name="south"><pose>0 -5 0.5 0 0 0</pose>
          <geometry><box><size>12 0.1 1.0</size></box></geometry></collision>
        <visual name="south_a"><pose>-3 -5 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.65 0.6 0.5 1</diffuse></material></visual>
        <visual name="south_b"><pose>3 -5 0.5 0 0 0</pose>
          <geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.5 0.55 0.5 1</ambient><diffuse>0.6 0.65 0.6 1</diffuse></material></visual>

        <collision name="east"><pose>6 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1.0</size></box></geometry></collision>
        <visual name="east_v"><pose>6 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1.0</size></box></geometry>
          <material><ambient>0.6 0.55 0.5 1</ambient><diffuse>0.7 0.65 0.6 1</diffuse></material></visual>

        <collision name="west"><pose>-6 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1.0</size></box></geometry></collision>
        <visual name="west_v"><pose>-6 0 0.5 0 0 0</pose>
          <geometry><box><size>0.1 10 1.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.6 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material></visual>

      </link>
    </model>

    <!--
      Ramps for tilt_guard. 12 degrees is under its 25 degree roll trigger and
      must NOT set it off; 30 degrees is over and must. Drive along them for
      pitch, across them for roll.
    -->
    <model name="ramp_12deg">
      <static>true</static>
      <pose>-3.0 2.0 0 0 -0.2094 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.0 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.0 0.05</size></box></geometry>
          <material><ambient>0.3 0.6 0.3 1</ambient><diffuse>0.35 0.7 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_30deg">
      <static>true</static>
      <pose>-3.0 -2.0 0 0 -0.5236 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 1.0 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.0 0.05</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.8 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
