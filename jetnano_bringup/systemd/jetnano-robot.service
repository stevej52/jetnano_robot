[Unit]
Description=jetnano robot: ros2 launch jetnano_bringup robot.launch.py
Documentation=https://github.com/stevej52/jetnano_robot
# The GPU visual odometry lives in the isaac_vo container; wait for it so the
# odometry launch does not have to.
After=network-online.target isaac-vo.service jetson-clocks.service
Wants=network-online.target isaac-vo.service jetson-clocks.service

[Service]
Type=simple
User=jeston
Group=jeston
SupplementaryGroups=docker i2c dialout input video
# Lets odometry.launch.py start the EKF at nice -10. When Nav2 or the camera
# pipeline starts, a burst of process start-ups starved it: 34 missed 30 Hz
# deadlines in one Nav2 start, worst 0.40 s; at -10, 3, worst 0.05 s
# (bench, 2026-09-27). Nothing else here raises its priority.
LimitNICE=-10
WorkingDirectory=/home/jeston
Environment=ROS_DOMAIN_ID=7
Environment=HOME=/home/jeston
# Without an RTC battery a cold power-up starts the clock in the past - at 1970, or, with
# robot-environment's rosie-clock (2026-09-28), at the time saved before she was switched
# off - and it jumps when NTP syncs; nodes started before the jump see negative time points
# and die (cuVSLAM/nvblox did, 2026-09-23). So wait up to 90 s for NTP, then start
# regardless (no network in the field). Until 2026-09-28 a clock later than the workspace's
# last build counted as real; a restored clock is later than that and still wrong.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 45); do [ "$(timedatectl show -p NTPSynchronized --value)" = "yes" ] && exit 0; sleep 2; done; echo "jetnano-robot: no time sync after 90 s, starting anyway"'
# What the robot boots with. Override in /etc/default/jetnano-robot, e.g.
#     ROBOT_ARGS="nvblox:=true use_cliff:=true location:=Ventura,California"
#     ANTHROPIC_API_KEY=sk-ant-...        (her brain; keep that file root-only, chmod 600)
# once the cliff sensors are fitted; no unit edit needed.
# nvblox:=true: the camera's 3D obstacle map for Nav2 and the collision guard
# as well as the GPU odometry (~40 Hz instead of 89; both far above the 10 Hz
# of the CPU path). A manual robot.launch.py defaults to odometry only.
Environment=ROBOT_ARGS=nvblox:=true
EnvironmentFile=-/etc/default/jetnano-robot
# A login shell so the workspace overlay is sourced the same way a terminal does.
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/jeston/ros2_ws/install/setup.bash && exec ros2 launch jetnano_bringup robot.launch.py $ROBOT_ARGS'
# ros2 launch shuts its nodes down on SIGINT (the lidar driver must not be
# SIGKILLed: the sensor then needs a USB replug). Give it time.
KillSignal=SIGINT
TimeoutStopSec=40
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
