<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetnano_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration that bring the whole jetnano
  robot up: description, PCA9685 driver, twist_mux, sensors, visual odometry
  and the EKF.</description>
  <maintainer email="stevej52@gmail.com">stevej52</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>jetnano_description</exec_depend>
  <exec_depend>jetnano_teleop</exec_depend>
  <exec_depend>ros2_pca9685</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
