<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jetnano_watchdog</name>
  <version>0.1.0</version>
  <description>A cheap live tally of the robot's topics (C++, no deserialisation) for the watchdog in jetnano_bringup</description>
  <maintainer email="stevej52@gmail.com">stevej52</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>diagnostic_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
